      "name": "1. Create (POST)",
      "item": [
        {
          "name": "1.1 Tambah Produk Lengkap (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Header Location exists\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "pm.test(\"Response body contains new product ID and data\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.kode).to.eql(\"PRD-004\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kode\": \"PRD-004\",\n  \"nama\": \"Headset Gaming RGB\",\n  \"kategori\": \"Aksesoris\",\n  \"harga\": 450000,\n  \"stok\": 20\n}"
