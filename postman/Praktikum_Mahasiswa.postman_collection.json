  "item": [
    {
      "name": "1. Create (POST)",
      "item": [
        {
          "name": "1.1 Tambah Data Mahasiswa Lengkap (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Header Location exists\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "pm.test(\"Response body contains new student ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.nim).to.eql(\"2024003\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"2024003\",\n  \"name\": \"Budi Santoso\",\n  \"major\": \"Informatika\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mahasiswa.php",
              "host": ["{{base_url}}"],
              "path": ["mahasiswa.php"]
            }
          }
        },
        {
          "name": "1.2 Tambah Mahasiswa NIM Duplikat (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
